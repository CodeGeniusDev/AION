GEMINI_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
AION_DISABLE_MODEL_CALLS=0
AION_LOG_LEVEL=INFO
AION_MAX_RETAINED_TASKS=500
AION_RATE_LIMIT_REQUESTS=60
AION_RATE_LIMIT_WINDOW_SECONDS=60
AION_REQUIRE_AUTH=0
AION_DEFAULT_TENANT_ID=default
# Set to a file path for durable SQLite storage across restarts.
# Leave empty for in-memory (data lost on restart).
# AION_MEMORY_DB_PATH=/data/aion_memory.db

# Workflow entity store path (Phase 1). Leave empty for in-memory.
# AION_WORKFLOW_DB_PATH=/data/aion_workflows.db

# Schedule store path (Phase 5). Leave empty for in-memory.
# AION_SCHEDULE_DB_PATH=/data/aion_schedules.db
# 1 = start the schedule runner thread. Fires only CREATE pending
# approvals — a human decision is still required for anything to run.
# AION_SCHEDULER_ENABLED=0

# --- Human-in-the-loop desktop tool approvals ---
# Approval ledger + audit log path. Leave empty for in-memory (tests).
# AION_APPROVAL_DB_PATH=/data/aion_approvals.db
# Seconds a pending approval stays approvable (default 300).
AION_APPROVAL_TTL_SECONDS=300
# Desktop agent bridge (the bridge reads the SAME AION_AGENT_SECRET value
# from its own environment — it is never passed as a CLI flag or to the frontend).
AION_AGENT_BRIDGE_URL=http://127.0.0.1:8080
AION_AGENT_SECRET=
AION_BRIDGE_TIMEOUT_SECONDS=30
# Tools that always require explicit human approval before execution.
AION_PROTECTED_DESKTOP_TOOLS=desktop_open_app,desktop_screenshot,browser_navigate,browser_screenshot,file_read,file_write,file_copy,social_post
# 1 = dispatch approved executions in a background task (default); 0 = inline.
AION_APPROVAL_DISPATCH_ASYNC=1
