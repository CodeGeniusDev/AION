# Copy to .env and fill in real values (git-ignored)
AION_AGENT_PORT=8080
AION_AGENT_SECRET=change-me-in-production

# Social posting (Phase 7) — official app credentials only, dry-run until
# these AND social.live_enabled AND a vault token are all real.
# Meta (Facebook Page + Instagram share one app):
AION_SOCIAL_META_CLIENT_ID=
AION_SOCIAL_META_CLIENT_SECRET=
AION_SOCIAL_FB_PAGE_ID=
AION_SOCIAL_IG_USER_ID=
# Pinterest:
AION_SOCIAL_PINTEREST_CLIENT_ID=
AION_SOCIAL_PINTEREST_CLIENT_SECRET=
AION_SOCIAL_PINTEREST_BOARD_ID=
# TikTok (needs Content Posting API app review for public posts):
AION_SOCIAL_TIKTOK_CLIENT_ID=
AION_SOCIAL_TIKTOK_CLIENT_SECRET=
